<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Herança: recebemos do Spring Boot as versões testadas de libs e plugins -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- busca no repositório Maven, não em ../pom.xml -->
    </parent>

    <groupId>br.com.sertaosense</groupId>
    <artifactId>sertaosense-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <!-- packaging pom: este projeto não gera jar, só organiza e configura os filhos -->
    <packaging>pom</packaging>

    <name>SertãoSense</name>
    <description>POM pai dos microsserviços do SertãoSense</description>

    <!-- Agregação: módulos que o Reactor compila juntos -->
    <modules>
        <module>dispositivos</module>
        <!-- Passo 2: descomentar quando as pastas existirem -->
        <!-- <module>ingestao</module> -->
        <!-- <module>analise</module> -->
        <!-- <module>notificacoes</module> -->
    </modules>

    <!-- Propriedades herdadas por todos os módulos -->
    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

</project>
